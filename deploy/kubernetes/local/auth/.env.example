# Local Kubernetes Auth credentials only; match postgres-password in both values and use at least 32 characters for jwt-signing-key.
postgres-password=replace-with-local-auth-postgres-password
connection-string=Host=auth-db;Port=5432;Database=authservice;Username=authservice;Password=replace-with-local-auth-postgres-password
jwt-signing-key=replace-with-local-jwt-signing-key-at-least-32-chars
