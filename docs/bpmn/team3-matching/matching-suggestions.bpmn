<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_matching-suggestions" targetNamespace="https://smartlost.example/bpmn/matching-suggestions" exporter="SmartLost BPMN documentation" exporterVersion="1">
  <bpmn:process id="Process_MatchingQuery" name="Matching Service — planned candidate selection and ranking" isExecutable="false">
    <bpmn:startEvent id="MatchStart" name="Ranked-candidate request received">
      <bpmn:outgoing>Flow_matching-suggestions_33</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MatchStart_message" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Projection" name="Load source projection, revision and processing state">
      <bpmn:incoming>Flow_matching-suggestions_33</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_34</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ProjectionReady" name="Current and eligible projection?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_matching-suggestions_34</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_35</bpmn:outgoing>
      <bpmn:outgoing>Flow_matching-suggestions_36</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Select" name="Select eligible opposite-type candidates from other authors">
      <bpmn:incoming>Flow_matching-suggestions_35</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_37</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Any" name="Candidates found?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_matching-suggestions_37</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_38</bpmn:outgoing>
      <bpmn:outgoing>Flow_matching-suggestions_39</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="NoCandidates" name="Set ready-empty ranked pool">
      <bpmn:incoming>Flow_matching-suggestions_39</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_42</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="NotReady" name="Set pending, failed or ineligible outcome">
      <bpmn:incoming>Flow_matching-suggestions_36</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_43</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="MatchJoin" name="Ranked outcome ready" gatewayDirection="Converging">
      <bpmn:incoming>Flow_matching-suggestions_41</bpmn:incoming>
      <bpmn:incoming>Flow_matching-suggestions_42</bpmn:incoming>
      <bpmn:incoming>Flow_matching-suggestions_43</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_44</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendPool" name="Return pool, revisions, reasons and ranking version or status">
      <bpmn:incoming>Flow_matching-suggestions_44</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_45</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="MatchEnd" name="Matching query completed">
      <bpmn:incoming>Flow_matching-suggestions_45</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="RankEach" name="Evaluate each candidate using cached evidence">
      <bpmn:incoming>Flow_matching-suggestions_38</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_40</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:startEvent id="RankStart" name="Candidate evaluation started">
        <bpmn:outgoing>Flow_matching-suggestions_25</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ReadCache" name="Read version-compatible cached embeddings">
        <bpmn:incoming>Flow_matching-suggestions_25</bpmn:incoming>
        <bpmn:outgoing>Flow_matching-suggestions_26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Compatible" name="Both embeddings compatible?" gatewayDirection="Diverging">
        <bpmn:incoming>Flow_matching-suggestions_26</bpmn:incoming>
        <bpmn:outgoing>Flow_matching-suggestions_27</bpmn:outgoing>
        <bpmn:outgoing>Flow_matching-suggestions_28</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Visual" name="Calculate visual similarity">
        <bpmn:incoming>Flow_matching-suggestions_27</bpmn:incoming>
        <bpmn:outgoing>Flow_matching-suggestions_29</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:task id="NoVisual" name="Omit visual score; retain metadata evidence">
        <bpmn:incoming>Flow_matching-suggestions_28</bpmn:incoming>
        <bpmn:outgoing>Flow_matching-suggestions_30</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="EvidenceJoin" name="Evidence ready" gatewayDirection="Converging">
        <bpmn:incoming>Flow_matching-suggestions_29</bpmn:incoming>
        <bpmn:incoming>Flow_matching-suggestions_30</bpmn:incoming>
        <bpmn:outgoing>Flow_matching-suggestions_31</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Combine" name="Combine available evidence; derive reasons">
        <bpmn:incoming>Flow_matching-suggestions_31</bpmn:incoming>
        <bpmn:outgoing>Flow_matching-suggestions_32</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="RankEnd" name="Candidate scored">
        <bpmn:incoming>Flow_matching-suggestions_32</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_matching-suggestions_25" sourceRef="RankStart" targetRef="ReadCache" />
      <bpmn:sequenceFlow id="Flow_matching-suggestions_26" sourceRef="ReadCache" targetRef="Compatible" />
      <bpmn:sequenceFlow id="Flow_matching-suggestions_27" name="Compatible" sourceRef="Compatible" targetRef="Visual">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">compatibleEmbeddings</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_matching-suggestions_28" name="Missing or incompatible" sourceRef="Compatible" targetRef="NoVisual">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not compatibleEmbeddings</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_matching-suggestions_29" sourceRef="Visual" targetRef="EvidenceJoin" />
      <bpmn:sequenceFlow id="Flow_matching-suggestions_30" sourceRef="NoVisual" targetRef="EvidenceJoin" />
      <bpmn:sequenceFlow id="Flow_matching-suggestions_31" sourceRef="EvidenceJoin" targetRef="Combine" />
      <bpmn:sequenceFlow id="Flow_matching-suggestions_32" sourceRef="Combine" targetRef="RankEnd" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="Sort" name="Apply relevance threshold and sort ranked pool">
      <bpmn:incoming>Flow_matching-suggestions_40</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_41</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_matching-suggestions_33" sourceRef="MatchStart" targetRef="Projection" />
    <bpmn:sequenceFlow id="Flow_matching-suggestions_34" sourceRef="Projection" targetRef="ProjectionReady" />
    <bpmn:sequenceFlow id="Flow_matching-suggestions_35" name="Ready" sourceRef="ProjectionReady" targetRef="Select">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">projectionCurrentAndEligible</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_matching-suggestions_36" name="Not ready" sourceRef="ProjectionReady" targetRef="NotReady">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not projectionCurrentAndEligible</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_matching-suggestions_37" sourceRef="Select" targetRef="Any" />
    <bpmn:sequenceFlow id="Flow_matching-suggestions_38" name="Yes" sourceRef="Any" targetRef="RankEach">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">candidatesFound</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_matching-suggestions_39" name="No" sourceRef="Any" targetRef="NoCandidates">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not candidatesFound</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_matching-suggestions_40" sourceRef="RankEach" targetRef="Sort" />
    <bpmn:sequenceFlow id="Flow_matching-suggestions_41" sourceRef="Sort" targetRef="MatchJoin" />
    <bpmn:sequenceFlow id="Flow_matching-suggestions_42" sourceRef="NoCandidates" targetRef="MatchJoin" />
    <bpmn:sequenceFlow id="Flow_matching-suggestions_43" sourceRef="NotReady" targetRef="MatchJoin" />
    <bpmn:sequenceFlow id="Flow_matching-suggestions_44" sourceRef="MatchJoin" targetRef="SendPool" />
    <bpmn:sequenceFlow id="Flow_matching-suggestions_45" sourceRef="SendPool" targetRef="MatchEnd" />
  </bpmn:process>
  <bpmn:process id="Process_ListingsQuery" name="Listings Service — planned authoritative checks and presentation" isExecutable="false">
    <bpmn:startEvent id="QueryStart" name="Suggestions requested">
      <bpmn:outgoing>Flow_matching-suggestions_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="QueryStart_message" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Authorize" name="Check token, ownership and source eligibility">
      <bpmn:incoming>Flow_matching-suggestions_1</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Allowed" name="Request allowed?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_matching-suggestions_2</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_matching-suggestions_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendQuery" name="Request ranked candidates for expected source revision">
      <bpmn:incoming>Flow_matching-suggestions_3</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="WaitQuery" name="Receive Matching outcome">
      <bpmn:incoming>Flow_matching-suggestions_5</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_6</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Ready" name="Ready result?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_matching-suggestions_6</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_matching-suggestions_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Recheck" name="Recheck authoritative source revision and eligibility">
      <bpmn:incoming>Flow_matching-suggestions_7</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="SourceCurrent" name="Source still current?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_matching-suggestions_9</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_matching-suggestions_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Filter" name="Recheck candidate revisions and decisions; take zero to three">
      <bpmn:incoming>Flow_matching-suggestions_10</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="GoodResult" name="Set suggestions or ready-empty result">
      <bpmn:incoming>Flow_matching-suggestions_12</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Unavailable" name="Set unavailable; preserve published listing">
      <bpmn:incoming>Flow_matching-suggestions_16</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AccessDenied" name="Set access or eligibility error">
      <bpmn:incoming>Flow_matching-suggestions_4</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Status" name="Keep pending, failed or unavailable status">
      <bpmn:incoming>Flow_matching-suggestions_8</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="StaleSource" name="Set refresh-required result">
      <bpmn:incoming>Flow_matching-suggestions_11</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="QueryJoin" name="Outcome ready" gatewayDirection="Converging">
      <bpmn:incoming>Flow_matching-suggestions_13</bpmn:incoming>
      <bpmn:incoming>Flow_matching-suggestions_17</bpmn:incoming>
      <bpmn:incoming>Flow_matching-suggestions_18</bpmn:incoming>
      <bpmn:incoming>Flow_matching-suggestions_19</bpmn:incoming>
      <bpmn:incoming>Flow_matching-suggestions_20</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="ReplyUser" name="Return suggestions or explicit status">
      <bpmn:incoming>Flow_matching-suggestions_21</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_22</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="QueryEnd" name="Request completed">
      <bpmn:incoming>Flow_matching-suggestions_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="QueryTimeout" name="Matching timeout" attachedToRef="WaitQuery">
      <bpmn:outgoing>Flow_matching-suggestions_14</bpmn:outgoing>
      <bpmn:timerEventDefinition id="QueryTimeout_definition">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">configuredTimeout</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="QueryFailure" name="Matching unavailable" attachedToRef="SendQuery">
      <bpmn:outgoing>Flow_matching-suggestions_15</bpmn:outgoing>
      <bpmn:errorEventDefinition id="QueryFailure_definition" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="UnavailableJoin" name="" gatewayDirection="Converging">
      <bpmn:incoming>Flow_matching-suggestions_14</bpmn:incoming>
      <bpmn:incoming>Flow_matching-suggestions_15</bpmn:incoming>
      <bpmn:outgoing>Flow_matching-suggestions_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_matching-suggestions_1" sourceRef="QueryStart" targetRef="Authorize" />
    <bpmn:sequenceFlow id="Flow_matching-suggestions_2" sourceRef="Authorize" targetRef="Allowed" />
    <bpmn:sequenceFlow id="Flow_matching-suggestions_3" name="Allowed" sourceRef="Allowed" targetRef="SendQuery">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">requestAllowed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_matching-suggestions_4" name="Denied" sourceRef="Allowed" targetRef="AccessDenied">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not requestAllowed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_matching-suggestions_5" sourceRef="SendQuery" targetRef="WaitQuery" />
    <bpmn:sequenceFlow id="Flow_matching-suggestions_6" sourceRef="WaitQuery" targetRef="Ready" />
    <bpmn:sequenceFlow id="Flow_matching-suggestions_7" name="Ready" sourceRef="Ready" targetRef="Recheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outcomeReady</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_matching-suggestions_8" name="Not ready" sourceRef="Ready" targetRef="Status">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not outcomeReady</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_matching-suggestions_9" sourceRef="Recheck" targetRef="SourceCurrent" />
    <bpmn:sequenceFlow id="Flow_matching-suggestions_10" name="Current" sourceRef="SourceCurrent" targetRef="Filter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sourceCurrent</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_matching-suggestions_11" name="Changed" sourceRef="SourceCurrent" targetRef="StaleSource">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not sourceCurrent</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_matching-suggestions_12" sourceRef="Filter" targetRef="GoodResult" />
    <bpmn:sequenceFlow id="Flow_matching-suggestions_13" sourceRef="GoodResult" targetRef="QueryJoin" />
    <bpmn:sequenceFlow id="Flow_matching-suggestions_14" sourceRef="QueryTimeout" targetRef="UnavailableJoin" />
    <bpmn:sequenceFlow id="Flow_matching-suggestions_15" sourceRef="QueryFailure" targetRef="UnavailableJoin" />
    <bpmn:sequenceFlow id="Flow_matching-suggestions_16" sourceRef="UnavailableJoin" targetRef="Unavailable" />
    <bpmn:sequenceFlow id="Flow_matching-suggestions_17" sourceRef="AccessDenied" targetRef="QueryJoin" />
    <bpmn:sequenceFlow id="Flow_matching-suggestions_18" sourceRef="Unavailable" targetRef="QueryJoin" />
    <bpmn:sequenceFlow id="Flow_matching-suggestions_19" sourceRef="Status" targetRef="QueryJoin" />
    <bpmn:sequenceFlow id="Flow_matching-suggestions_20" sourceRef="StaleSource" targetRef="QueryJoin" />
    <bpmn:sequenceFlow id="Flow_matching-suggestions_21" sourceRef="QueryJoin" targetRef="ReplyUser" />
    <bpmn:sequenceFlow id="Flow_matching-suggestions_22" sourceRef="ReplyUser" targetRef="QueryEnd" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_matching-suggestions">
    <bpmn:participant id="ListingsQuery" name="Listings Service — planned authoritative checks and presentation" processRef="Process_ListingsQuery" />
    <bpmn:participant id="MatchingQuery" name="Matching Service — planned candidate selection and ranking" processRef="Process_MatchingQuery" />
    <bpmn:participant id="SuggestionUser" name="Registered User" />
    <bpmn:messageFlow id="MessageFlow_matching-suggestions_23" name="Suggestion request" sourceRef="SuggestionUser" targetRef="QueryStart" />
    <bpmn:messageFlow id="MessageFlow_matching-suggestions_24" name="Suggestions or status" sourceRef="ReplyUser" targetRef="SuggestionUser" />
    <bpmn:messageFlow id="MessageFlow_matching-suggestions_46" name="Source listing ID and expected revision" sourceRef="SendQuery" targetRef="MatchStart" />
    <bpmn:messageFlow id="MessageFlow_matching-suggestions_47" name="Ranked pool or processing status" sourceRef="SendPool" targetRef="WaitQuery" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_matching-suggestions">
    <bpmndi:BPMNPlane id="Plane_matching-suggestions" bpmnElement="Collaboration_matching-suggestions">
      <bpmndi:BPMNShape id="ListingsQuery_di" bpmnElement="ListingsQuery" isHorizontal="true">
        <dc:Bounds x="40" y="200" width="2710" height="670" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MatchingQuery_di" bpmnElement="MatchingQuery" isHorizontal="true">
        <dc:Bounds x="40" y="990" width="2710" height="680" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SuggestionUser_di" bpmnElement="SuggestionUser" isHorizontal="true">
        <dc:Bounds x="40" y="50" width="2710" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="QueryStart_di" bpmnElement="QueryStart">
        <dc:Bounds x="110" y="330" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="63" y="375" width="130" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Authorize_di" bpmnElement="Authorize">
        <dc:Bounds x="210" y="310" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Allowed_di" bpmnElement="Allowed" isMarkerVisible="true">
        <dc:Bounds x="440" y="325" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="400" y="384" width="130" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendQuery_di" bpmnElement="SendQuery">
        <dc:Bounds x="560" y="310" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WaitQuery_di" bpmnElement="WaitQuery">
        <dc:Bounds x="790" y="310" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ready_di" bpmnElement="Ready" isMarkerVisible="true">
        <dc:Bounds x="1020" y="325" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="980" y="384" width="130" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Recheck_di" bpmnElement="Recheck">
        <dc:Bounds x="1140" y="310" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SourceCurrent_di" bpmnElement="SourceCurrent" isMarkerVisible="true">
        <dc:Bounds x="1370" y="325" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1330" y="384" width="130" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Filter_di" bpmnElement="Filter">
        <dc:Bounds x="1500" y="310" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GoodResult_di" bpmnElement="GoodResult">
        <dc:Bounds x="1740" y="310" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Unavailable_di" bpmnElement="Unavailable">
        <dc:Bounds x="800" y="650" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AccessDenied_di" bpmnElement="AccessDenied">
        <dc:Bounds x="500" y="650" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Status_di" bpmnElement="Status">
        <dc:Bounds x="1100" y="650" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StaleSource_di" bpmnElement="StaleSource">
        <dc:Bounds x="1440" y="650" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="QueryJoin_di" bpmnElement="QueryJoin" isMarkerVisible="true">
        <dc:Bounds x="2020" y="635" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1980" y="694" width="130" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReplyUser_di" bpmnElement="ReplyUser">
