{
  "ConnectionStrings": {
    "AuthDatabase": "Host=localhost;Port=5432;Database=authservice;Username=authservice;Password=change-me-dev-db-password"
  },
  "OutboxDelivery": {
    "PollInterval": "00:00:02",
    "ServiceKey": "replace-with-random-service-key-of-at-least-32-characters",
    "Routes": {
      "auth.user.created": "https://consumer.invalid/",
      "auth.user.identity_changed": "https://consumer.invalid/"
    }
  },
  "EmailConfirmation": {
    "EncryptionKey": "replace-with-same-key-as-auth-api",
    "ConfirmationBaseUrl": "http://localhost:5048/api/auth/confirm-email"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "FromAddress": "noreply@smartlost.local",
    "FromDisplayName": "SmartLost"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "UserName": "replace-with-broker-username",
    "Password": "replace-with-broker-password",
    "Port": 5672,
    "VirtualHost": "smartlost",
    "Exchange": "smartlost.events",
    "ConnectionName": "smartlost-auth-identity",
    "Bindings": { "smartlost.auth.identity": ["auth.user.created", "auth.user.identity_changed"] }
  },
  "Outbox": {
    "BatchSize": 20,
    "MaximumAttempts": 8,
    "InitialRetryDelay": "00:00:02",
    "MaximumRetryDelay": "00:05:00",
    "DeliveryTimeout": "00:00:30",
    "LeaseDuration": "00:02:00"
  },
  "Worker": {
    "Mode": "Batch",
    "MaximumBatches": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
