@SmartLost.AuthService.Api_HostAddress = http://localhost:5048

POST {{SmartLost.AuthService.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "userName": "alex.popescu",
  "email": "alex.popescu@example.com",
  "password": "P@ssw0rd123!"
}

###

# Demo seeded user login
# @name login
POST {{SmartLost.AuthService.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "demo@smartlost.local",
  "password": "DemoUser123!"
}

###

@authToken = {{login.response.body.accessToken}}

# Current authenticated user details
GET {{SmartLost.AuthService.Api_HostAddress}}/api/auth/me
Authorization: Bearer {{authToken}}

###

# Security audit log inspection (Aspect-Oriented pipeline behavior demonstration)
GET {{SmartLost.AuthService.Api_HostAddress}}/api/auth/security/audit-logs?limit=20
Authorization: Bearer {{authToken}}

###

# Replace with the latest refreshToken returned by register, login or refresh.
POST {{SmartLost.AuthService.Api_HostAddress}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "paste-the-latest-refresh-token-here"
}

###
