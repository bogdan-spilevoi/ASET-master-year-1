<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_listing-publication" targetNamespace="https://smartlost.example/bpmn/listing-publication" exporter="SmartLost BPMN documentation" exporterVersion="1">
  <bpmn:process id="Process_Listings" name="Listings Service — planned publication process" isExecutable="false">
    <bpmn:startEvent id="PubStart" name="New draft requested">
      <bpmn:outgoing>Flow_listing-publication_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="PubStart_message" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="CheckAccess" name="Authenticate caller">
      <bpmn:incoming>Flow_listing-publication_1</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Access" name="Authenticated?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_listing-publication_2</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_listing-publication_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Draft" name="Create private draft">
      <bpmn:incoming>Flow_listing-publication_3</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="Details" name="Receive details and optional photo">
      <bpmn:incoming>Flow_listing-publication_6</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_7</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="HasPhoto" name="Photo supplied?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_listing-publication_7</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_listing-publication_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ValidatePhoto" name="Validate JPEG/PNG decoding and size up to 10 MiB">
      <bpmn:incoming>Flow_listing-publication_8</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="PhotoValid" name="Photo valid?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_listing-publication_10</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_listing-publication_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Upload" name="Upload photo and associate metadata">
      <bpmn:incoming>Flow_listing-publication_11</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="PhotoJoin" name="Photo step complete" gatewayDirection="Converging">
      <bpmn:incoming>Flow_listing-publication_9</bpmn:incoming>
      <bpmn:incoming>Flow_listing-publication_16</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="WantAI" name="Photo present and analysis requested?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_listing-publication_17</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_listing-publication_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="AskAI" name="Request bounded photo analysis">
      <bpmn:incoming>Flow_listing-publication_18</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Usable" name="Result valid and still current?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_listing-publication_20</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_listing-publication_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Propose" name="Send editable category suggestions">
      <bpmn:incoming>Flow_listing-publication_21</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_27</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="Fallback" name="Keep manual values; discard failed or stale analysis">
      <bpmn:incoming>Flow_listing-publication_25</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ReviewJoin" name="Review ready" gatewayDirection="Converging">
      <bpmn:incoming>Flow_listing-publication_19</bpmn:incoming>
      <bpmn:incoming>Flow_listing-publication_27</bpmn:incoming>
      <bpmn:incoming>Flow_listing-publication_28</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Review" name="Request final category review">
      <bpmn:incoming>Flow_listing-publication_29</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_30</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Confirmed" name="Receive confirmed categories and action">
      <bpmn:incoming>Flow_listing-publication_30</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_31</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="PublishNow" name="Publish now?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_listing-publication_31</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_32</bpmn:outgoing>
      <bpmn:outgoing>Flow_listing-publication_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="SaveDraft" name="Save private draft">
      <bpmn:incoming>Flow_listing-publication_33</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_44</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Idempotency" name="Check prior publication request">
      <bpmn:incoming>Flow_listing-publication_32</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_34</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Already" name="Already committed?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_listing-publication_34</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_35</bpmn:outgoing>
      <bpmn:outgoing>Flow_listing-publication_36</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ValidatePublish" name="Recheck owner, revision and required fields">
      <bpmn:incoming>Flow_listing-publication_36</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_37</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CanPublish" name="Current and valid?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_listing-publication_37</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_38</bpmn:outgoing>
      <bpmn:outgoing>Flow_listing-publication_39</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Normalize" name="Normalize confirmed categories">
      <bpmn:incoming>Flow_listing-publication_38</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_40</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PublishCommit" name="Commit Open listing and durable Matching update together">
      <bpmn:incoming>Flow_listing-publication_40</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_41</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="Published" name="Set publication success; synchronization pending">
      <bpmn:incoming>Flow_listing-publication_41</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_43</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Existing" name="Use existing publication result">
      <bpmn:incoming>Flow_listing-publication_35</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_45</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Reject" name="Set access, validation or revision-conflict result">
      <bpmn:incoming>Flow_listing-publication_26</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_46</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="PhotoIssue" name="Report photo issue; request replacement or removal">
      <bpmn:incoming>Flow_listing-publication_14</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="PhotoIssueJoin" name="Photo correction needed" gatewayDirection="Converging">
      <bpmn:incoming>Flow_listing-publication_12</bpmn:incoming>
      <bpmn:incoming>Flow_listing-publication_13</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="CommitFailed" name="Keep draft private; report failed publication">
      <bpmn:incoming>Flow_listing-publication_42</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_47</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="PubResult" name="Outcome ready" gatewayDirection="Converging">
      <bpmn:incoming>Flow_listing-publication_43</bpmn:incoming>
      <bpmn:incoming>Flow_listing-publication_44</bpmn:incoming>
      <bpmn:incoming>Flow_listing-publication_45</bpmn:incoming>
      <bpmn:incoming>Flow_listing-publication_46</bpmn:incoming>
      <bpmn:incoming>Flow_listing-publication_47</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_48</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="PubReply" name="Return draft or publication outcome">
      <bpmn:incoming>Flow_listing-publication_48</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_49</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="PubEnd" name="Request completed">
      <bpmn:incoming>Flow_listing-publication_49</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="DetailsJoin" name="" gatewayDirection="Converging">
      <bpmn:incoming>Flow_listing-publication_5</bpmn:incoming>
      <bpmn:incoming>Flow_listing-publication_15</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="FallbackJoin" name="" gatewayDirection="Converging">
      <bpmn:incoming>Flow_listing-publication_22</bpmn:incoming>
      <bpmn:incoming>Flow_listing-publication_23</bpmn:incoming>
      <bpmn:incoming>Flow_listing-publication_24</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="RejectJoin" name="" gatewayDirection="Converging">
      <bpmn:incoming>Flow_listing-publication_4</bpmn:incoming>
      <bpmn:incoming>Flow_listing-publication_39</bpmn:incoming>
      <bpmn:outgoing>Flow_listing-publication_26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:boundaryEvent id="UploadError" name="Upload failed" attachedToRef="Upload">
      <bpmn:outgoing>Flow_listing-publication_13</bpmn:outgoing>
      <bpmn:errorEventDefinition id="UploadError_definition" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="AITimeout" name="Analysis timeout" attachedToRef="AskAI">
      <bpmn:outgoing>Flow_listing-publication_23</bpmn:outgoing>
      <bpmn:timerEventDefinition id="AITimeout_definition">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">configuredTimeout</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="AIError" name="Analysis failed" attachedToRef="AskAI">
      <bpmn:outgoing>Flow_listing-publication_24</bpmn:outgoing>
      <bpmn:errorEventDefinition id="AIError_definition" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="PublishError" name="Commit failed" attachedToRef="PublishCommit">
      <bpmn:outgoing>Flow_listing-publication_42</bpmn:outgoing>
      <bpmn:errorEventDefinition id="PublishError_definition" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_listing-publication_1" sourceRef="PubStart" targetRef="CheckAccess" />
    <bpmn:sequenceFlow id="Flow_listing-publication_2" sourceRef="CheckAccess" targetRef="Access" />
    <bpmn:sequenceFlow id="Flow_listing-publication_3" name="Allowed" sourceRef="Access" targetRef="Draft">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">accessAllowed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_listing-publication_4" name="Denied" sourceRef="Access" targetRef="RejectJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not accessAllowed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_listing-publication_5" sourceRef="Draft" targetRef="DetailsJoin" />
    <bpmn:sequenceFlow id="Flow_listing-publication_6" sourceRef="DetailsJoin" targetRef="Details" />
    <bpmn:sequenceFlow id="Flow_listing-publication_7" sourceRef="Details" targetRef="HasPhoto" />
    <bpmn:sequenceFlow id="Flow_listing-publication_8" name="Yes" sourceRef="HasPhoto" targetRef="ValidatePhoto">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">photoSupplied</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_listing-publication_9" name="No" sourceRef="HasPhoto" targetRef="PhotoJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not photoSupplied</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_listing-publication_10" sourceRef="ValidatePhoto" targetRef="PhotoValid" />
    <bpmn:sequenceFlow id="Flow_listing-publication_11" name="Valid" sourceRef="PhotoValid" targetRef="Upload">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">photoValid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_listing-publication_12" name="Invalid" sourceRef="PhotoValid" targetRef="PhotoIssueJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not photoValid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_listing-publication_13" sourceRef="UploadError" targetRef="PhotoIssueJoin" />
    <bpmn:sequenceFlow id="Flow_listing-publication_14" sourceRef="PhotoIssueJoin" targetRef="PhotoIssue" />
    <bpmn:sequenceFlow id="Flow_listing-publication_15" sourceRef="PhotoIssue" targetRef="DetailsJoin" />
    <bpmn:sequenceFlow id="Flow_listing-publication_16" sourceRef="Upload" targetRef="PhotoJoin" />
    <bpmn:sequenceFlow id="Flow_listing-publication_17" sourceRef="PhotoJoin" targetRef="WantAI" />
    <bpmn:sequenceFlow id="Flow_listing-publication_18" name="Yes" sourceRef="WantAI" targetRef="AskAI">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">photoPresent and analysisRequested</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_listing-publication_19" name="No" sourceRef="WantAI" targetRef="ReviewJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not (photoPresent and analysisRequested)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_listing-publication_20" sourceRef="AskAI" targetRef="Usable" />
    <bpmn:sequenceFlow id="Flow_listing-publication_21" name="Usable" sourceRef="Usable" targetRef="Propose">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">validResult and currentPhotoAndDraft</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_listing-publication_22" name="Stale or invalid" sourceRef="Usable" targetRef="FallbackJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not (validResult and currentPhotoAndDraft)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_listing-publication_23" sourceRef="AITimeout" targetRef="FallbackJoin" />
    <bpmn:sequenceFlow id="Flow_listing-publication_24" sourceRef="AIError" targetRef="FallbackJoin" />
    <bpmn:sequenceFlow id="Flow_listing-publication_25" sourceRef="FallbackJoin" targetRef="Fallback" />
    <bpmn:sequenceFlow id="Flow_listing-publication_26" sourceRef="RejectJoin" targetRef="Reject" />
    <bpmn:sequenceFlow id="Flow_listing-publication_27" sourceRef="Propose" targetRef="ReviewJoin" />
    <bpmn:sequenceFlow id="Flow_listing-publication_28" sourceRef="Fallback" targetRef="ReviewJoin" />
    <bpmn:sequenceFlow id="Flow_listing-publication_29" sourceRef="ReviewJoin" targetRef="Review" />
    <bpmn:sequenceFlow id="Flow_listing-publication_30" sourceRef="Review" targetRef="Confirmed" />
    <bpmn:sequenceFlow id="Flow_listing-publication_31" sourceRef="Confirmed" targetRef="PublishNow" />
    <bpmn:sequenceFlow id="Flow_listing-publication_32" name="Publish" sourceRef="PublishNow" targetRef="Idempotency">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">publishRequested</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_listing-publication_33" name="Save draft" sourceRef="PublishNow" targetRef="SaveDraft">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not publishRequested</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_listing-publication_34" sourceRef="Idempotency" targetRef="Already" />
    <bpmn:sequenceFlow id="Flow_listing-publication_35" name="Yes" sourceRef="Already" targetRef="Existing">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">publicationExists</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_listing-publication_36" name="No" sourceRef="Already" targetRef="ValidatePublish">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not publicationExists</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_listing-publication_37" sourceRef="ValidatePublish" targetRef="CanPublish" />
    <bpmn:sequenceFlow id="Flow_listing-publication_38" name="Valid" sourceRef="CanPublish" targetRef="Normalize">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">authorizedAndCurrentAndValid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_listing-publication_39" name="Invalid or stale" sourceRef="CanPublish" targetRef="RejectJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not authorizedAndCurrentAndValid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_listing-publication_40" sourceRef="Normalize" targetRef="PublishCommit" />
    <bpmn:sequenceFlow id="Flow_listing-publication_41" sourceRef="PublishCommit" targetRef="Published" />
    <bpmn:sequenceFlow id="Flow_listing-publication_42" sourceRef="PublishError" targetRef="CommitFailed" />
    <bpmn:sequenceFlow id="Flow_listing-publication_43" sourceRef="Published" targetRef="PubResult" />
    <bpmn:sequenceFlow id="Flow_listing-publication_44" sourceRef="SaveDraft" targetRef="PubResult" />
    <bpmn:sequenceFlow id="Flow_listing-publication_45" sourceRef="Existing" targetRef="PubResult" />
    <bpmn:sequenceFlow id="Flow_listing-publication_46" sourceRef="Reject" targetRef="PubResult" />
    <bpmn:sequenceFlow id="Flow_listing-publication_47" sourceRef="CommitFailed" targetRef="PubResult" />
    <bpmn:sequenceFlow id="Flow_listing-publication_48" sourceRef="PubResult" targetRef="PubReply" />
    <bpmn:sequenceFlow id="Flow_listing-publication_49" sourceRef="PubReply" targetRef="PubEnd" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_listing-publication">
    <bpmn:participant id="Listings" name="Listings Service — planned publication process" processRef="Process_Listings" />
    <bpmn:participant id="User" name="Registered User" />
    <bpmn:participant id="Storage" name="Private Photo Storage — planned" />
    <bpmn:participant id="Analysis" name="Matching / local AI analysis — planned" />
    <bpmn:messageFlow id="MessageFlow_listing-publication_50" name="Draft request" sourceRef="User" targetRef="PubStart" />
    <bpmn:messageFlow id="MessageFlow_listing-publication_51" name="Draft details and photo" sourceRef="User" targetRef="Details" />
    <bpmn:messageFlow id="MessageFlow_listing-publication_52" name="Review requested" sourceRef="Review" targetRef="User" />
    <bpmn:messageFlow id="MessageFlow_listing-publication_53" name="Confirmed values and action" sourceRef="User" targetRef="Confirmed" />
    <bpmn:messageFlow id="MessageFlow_listing-publication_54" name="Publication outcome" sourceRef="PubReply" targetRef="User" />
    <bpmn:messageFlow id="MessageFlow_listing-publication_55" name="Photo upload" sourceRef="Upload" targetRef="Storage" />
    <bpmn:messageFlow id="MessageFlow_listing-publication_56" name="Analysis request" sourceRef="AskAI" targetRef="Analysis" />
    <bpmn:messageFlow id="MessageFlow_listing-publication_57" name="Analysis response" sourceRef="Analysis" targetRef="AskAI" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_listing-publication">
    <bpmndi:BPMNPlane id="Plane_listing-publication" bpmnElement="Collaboration_listing-publication">
      <bpmndi:BPMNShape id="Listings_di" bpmnElement="Listings" isHorizontal="true">
        <dc:Bounds x="40" y="230" width="2740" height="1240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="User_di" bpmnElement="User" isHorizontal="true">
        <dc:Bounds x="40" y="50" width="2740" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Storage_di" bpmnElement="Storage" isHorizontal="true">
        <dc:Bounds x="40" y="1540" width="1100" height="65" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Analysis_di" bpmnElement="Analysis" isHorizontal="true">
        <dc:Bounds x="1540" y="1540" width="1240" height="65" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PubStart_di" bpmnElement="PubStart">
        <dc:Bounds x="110" y="330" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="63" y="375" width="130" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CheckAccess_di" bpmnElement="CheckAccess">
        <dc:Bounds x="210" y="310" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Access_di" bpmnElement="Access" isMarkerVisible="true">
        <dc:Bounds x="440" y="325" width="50" height="50" />
