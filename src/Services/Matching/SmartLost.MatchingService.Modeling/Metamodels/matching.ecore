<?xml version="1.0" encoding="utf-8"?>
<ecore:EPackage xmlns:xmi="http://www.omg.org/XMI"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
                xmi:version="2.0" name="Matching"
                nsURI="https://smartlost.example/models/matching/v1" nsPrefix="matching">
  <!-- Matching-owned structural model; runtime domain integration is separate. -->
  <eClassifiers xsi:type="ecore:EDataType" name="Guid" instanceClassName="System.Guid" />
  <eClassifiers xsi:type="ecore:EEnum" name="ListingType">
    <eLiterals name="Lost" value="0" />
    <eLiterals name="Found" value="1" />
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SearchListing">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="listingId" lowerBound="1" iD="true" eType="#//Guid" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="sourceRevision" lowerBound="1" defaultValueLiteral="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="changeSequence" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELong" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="type" lowerBound="1" defaultValueLiteral="Lost" eType="#//ListingType" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="authorId" lowerBound="1" eType="#//Guid" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="categoryKeys" upperBound="-1" ordered="false" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="colour"  eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="traits" upperBound="-1" ordered="false" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="occurredOn" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="location" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="eligible" lowerBound="1" defaultValueLiteral="false" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" />
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ImageEmbedding">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1" iD="true" eType="#//Guid" />
    <!-- Independent cache record: one non-containment projection reference; no duplicated ListingId. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="searchListing" lowerBound="1" eType="#//SearchListing" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="photoId" lowerBound="1" eType="#//Guid" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="photoRevision" lowerBound="1" defaultValueLiteral="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="modelVersion" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="preprocessingVersion" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dimensions" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt" />
    <!-- Ordered vector: repeated numeric components must be retained. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="vector" lowerBound="1" upperBound="-1" unique="false" ordered="true" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat" />
  </eClassifiers>
</ecore:EPackage>
