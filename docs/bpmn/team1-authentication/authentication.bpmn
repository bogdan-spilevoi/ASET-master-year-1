<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_authentication" targetNamespace="https://smartlost.example/bpmn/authentication" exporter="SmartLost BPMN documentation" exporterVersion="1">
  <bpmn:process id="Process_Auth" name="Auth Service — implemented registration and login" isExecutable="false">
    <bpmn:startEvent id="AuthStart" name="Authentication request received">
      <bpmn:outgoing>Flow_authentication_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="AuthStart_message" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Validate" name="Map and validate request">
      <bpmn:incoming>Flow_authentication_1</bpmn:incoming>
      <bpmn:outgoing>Flow_authentication_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Valid" name="Request valid?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_authentication_2</bpmn:incoming>
      <bpmn:outgoing>Flow_authentication_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_authentication_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Kind" name="Register or login?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_authentication_3</bpmn:incoming>
      <bpmn:outgoing>Flow_authentication_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_authentication_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="UniqueCheck" name="Check normalized username and email">
      <bpmn:incoming>Flow_authentication_5</bpmn:incoming>
      <bpmn:outgoing>Flow_authentication_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Unique" name="Account available?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_authentication_7</bpmn:incoming>
      <bpmn:outgoing>Flow_authentication_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_authentication_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Create" name="Create account and hash password">
      <bpmn:incoming>Flow_authentication_8</bpmn:incoming>
      <bpmn:outgoing>Flow_authentication_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Credentials" name="Load account and verify password">
      <bpmn:incoming>Flow_authentication_6</bpmn:incoming>
      <bpmn:outgoing>Flow_authentication_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CredentialValid" name="Credentials valid?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_authentication_11</bpmn:incoming>
      <bpmn:outgoing>Flow_authentication_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_authentication_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="JoinAuth" name="Authenticated operation" gatewayDirection="Converging">
      <bpmn:incoming>Flow_authentication_10</bpmn:incoming>
      <bpmn:incoming>Flow_authentication_12</bpmn:incoming>
      <bpmn:outgoing>Flow_authentication_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Session" name="Prepare JWT, session and token history">
      <bpmn:incoming>Flow_authentication_14</bpmn:incoming>
      <bpmn:outgoing>Flow_authentication_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Commit" name="Atomically save tracked rows and selected outbox events">
      <bpmn:incoming>Flow_authentication_15</bpmn:incoming>
      <bpmn:outgoing>Flow_authentication_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="Success" name="Set success: 201 register / 200 login">
      <bpmn:incoming>Flow_authentication_16</bpmn:incoming>
      <bpmn:outgoing>Flow_authentication_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Invalid" name="Set 400 validation result">
      <bpmn:incoming>Flow_authentication_4</bpmn:incoming>
      <bpmn:outgoing>Flow_authentication_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Conflict" name="Set 409 account conflict">
      <bpmn:incoming>Flow_authentication_9</bpmn:incoming>
      <bpmn:outgoing>Flow_authentication_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Unauthorized" name="Set 401 invalid credentials">
      <bpmn:incoming>Flow_authentication_13</bpmn:incoming>
      <bpmn:outgoing>Flow_authentication_22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SaveError" name="Map save error to 409 or sanitized 500">
      <bpmn:incoming>Flow_authentication_17</bpmn:incoming>
      <bpmn:outgoing>Flow_authentication_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ResponseJoin" name="Response ready" gatewayDirection="Converging">
      <bpmn:incoming>Flow_authentication_18</bpmn:incoming>
      <bpmn:incoming>Flow_authentication_19</bpmn:incoming>
      <bpmn:incoming>Flow_authentication_20</bpmn:incoming>
      <bpmn:incoming>Flow_authentication_21</bpmn:incoming>
      <bpmn:incoming>Flow_authentication_22</bpmn:incoming>
      <bpmn:outgoing>Flow_authentication_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Reply" name="Return authentication result">
      <bpmn:incoming>Flow_authentication_23</bpmn:incoming>
      <bpmn:outgoing>Flow_authentication_24</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="AuthEnd" name="Request completed">
      <bpmn:incoming>Flow_authentication_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="CommitError" name="Save failed" attachedToRef="Commit">
      <bpmn:outgoing>Flow_authentication_17</bpmn:outgoing>
      <bpmn:errorEventDefinition id="CommitError_definition" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_authentication_1" sourceRef="AuthStart" targetRef="Validate" />
    <bpmn:sequenceFlow id="Flow_authentication_2" sourceRef="Validate" targetRef="Valid" />
    <bpmn:sequenceFlow id="Flow_authentication_3" name="Valid" sourceRef="Valid" targetRef="Kind">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">requestValid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_authentication_4" name="Invalid" sourceRef="Valid" targetRef="Invalid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not requestValid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_authentication_5" name="Register" sourceRef="Kind" targetRef="UniqueCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">operation = register</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_authentication_6" name="Login" sourceRef="Kind" targetRef="Credentials">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">operation = login</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_authentication_7" sourceRef="UniqueCheck" targetRef="Unique" />
    <bpmn:sequenceFlow id="Flow_authentication_8" name="Available" sourceRef="Unique" targetRef="Create">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not accountExists</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_authentication_9" name="Exists" sourceRef="Unique" targetRef="Conflict">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">accountExists</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_authentication_10" sourceRef="Create" targetRef="JoinAuth" />
    <bpmn:sequenceFlow id="Flow_authentication_11" sourceRef="Credentials" targetRef="CredentialValid" />
    <bpmn:sequenceFlow id="Flow_authentication_12" name="Valid" sourceRef="CredentialValid" targetRef="JoinAuth">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">credentialsValid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_authentication_13" name="Invalid" sourceRef="CredentialValid" targetRef="Unauthorized">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not credentialsValid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_authentication_14" sourceRef="JoinAuth" targetRef="Session" />
    <bpmn:sequenceFlow id="Flow_authentication_15" sourceRef="Session" targetRef="Commit" />
    <bpmn:sequenceFlow id="Flow_authentication_16" sourceRef="Commit" targetRef="Success" />
    <bpmn:sequenceFlow id="Flow_authentication_17" sourceRef="CommitError" targetRef="SaveError" />
    <bpmn:sequenceFlow id="Flow_authentication_18" sourceRef="Success" targetRef="ResponseJoin" />
    <bpmn:sequenceFlow id="Flow_authentication_19" sourceRef="SaveError" targetRef="ResponseJoin" />
    <bpmn:sequenceFlow id="Flow_authentication_20" sourceRef="Conflict" targetRef="ResponseJoin" />
    <bpmn:sequenceFlow id="Flow_authentication_21" sourceRef="Invalid" targetRef="ResponseJoin" />
    <bpmn:sequenceFlow id="Flow_authentication_22" sourceRef="Unauthorized" targetRef="ResponseJoin" />
    <bpmn:sequenceFlow id="Flow_authentication_23" sourceRef="ResponseJoin" targetRef="Reply" />
    <bpmn:sequenceFlow id="Flow_authentication_24" sourceRef="Reply" targetRef="AuthEnd" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_authentication">
    <bpmn:participant id="Auth" name="Auth Service — implemented registration and login" processRef="Process_Auth" />
    <bpmn:participant id="Client" name="API Client" />
    <bpmn:messageFlow id="MessageFlow_authentication_25" name="Register / login request" sourceRef="Client" targetRef="AuthStart" />
    <bpmn:messageFlow id="MessageFlow_authentication_26" name="HTTP response" sourceRef="Reply" targetRef="Client" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_authentication">
