{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "smartlost-web": {
      "projectType": "application", "root": "", "sourceRoot": "src", "prefix": "sl",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts", "index": "src/index.html", "tsConfig": "tsconfig.app.json",
            "outputPath": "dist/smartlost-web", "styles": ["src/styles.scss"],
            "assets": [{ "glob": "**/*", "input": "public" }]
          },
          "configurations": {
            "production": { "outputHashing": "all", "budgets": [{ "type": "initial", "maximumWarning": "550kB", "maximumError": "850kB" }] },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "buildTarget": "smartlost-web:build:development", "proxyConfig": "proxy.conf.json" }
        }
      }
    }
  },
  "cli": { "analytics": false }
}
